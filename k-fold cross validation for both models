k = 5;

accuracies = zeros(k, 1);
precisions = zeros(k, 1);
recalls = zeros(k, 1);
f1scores = zeros(k, 1);

cv = cvpartition(targets_balanced, 'KFold', k);
for i = 1:k
    
    train_indices = training(cv, i);
    test_indices = test(cv, i);
  
    train_inputs = inputs_balanced(train_indices, :);
    train_targets = targets_balanced(train_indices);
    test_inputs = inputs_balanced(test_indices, :);
    test_targets = targets_balanced(test_indices);
    
    net = lvqnet(numClasses * numPrototypes);
    
    net.trainParam.epochs = 50; % Set epochs to 50
    
    [net, ~] = train(net, train_inputs', train_targets');
    
    outputs = net(test_inputs');
    
    [~, predictedLabels] = max(outputs, [], 1);
    
    accuracies(i) = sum(predictedLabels' == test_targets) / length(test_targets);
    
    confMat = confusionmat(test_targets, predictedLabels');
    
    precision = diag(confMat) ./ sum(confMat, 2);
    recall = diag(confMat) ./ sum(confMat, 1)';
    f1score = 2 * (precision .* recall) ./ (precision + recall);
    
    precisions(i) = nanmean(precision);
    recalls(i) = nanmean(recall);
    f1scores(i) = nanmean(f1score);
    
    fprintf('Fold %d Results:\n', i);
    fprintf('Accuracy: %.2f%%\n', accuracies(i) * 100);
    fprintf('Precision: %.2f\n', precisions(i));
    fprintf('Recall: %.2f\n', recalls(i));
    fprintf('F1-Score: %.2f\n', f1scores(i));
    fprintf('\n');
end

fprintf('K-Fold Cross-Validation Results:\n');
for i = 1:k
    fprintf('Fold %d:\n', i);
    fprintf('Accuracy: %.2f%%\n', accuracies(i) * 100);
