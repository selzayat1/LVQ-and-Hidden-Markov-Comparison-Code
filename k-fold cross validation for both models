    [trainDataDiscretized, C] = kmeans(trainData, numClusters, 'MaxIter', maxIter, 'Replicates', numReplicates);
    testDataDiscretized = knnsearch(C, testData);

    numStates = 2; % Number of hidden states
    transMat = [0.7, 0.3; 0.3, 0.7];
