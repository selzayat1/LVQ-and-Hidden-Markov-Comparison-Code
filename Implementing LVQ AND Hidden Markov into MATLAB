data_native = readmatrix('s01_ex05.txt');
data_resting = readmatrix('s01_ex01_s02 (Filtered).txt');

eeg_native = data_native(:, 2:5);
eeg_resting = data_resting(:, 2:5);

labels_native = ones(size(eeg_native, 1), 1);
labels_resting = zeros(size(eeg_resting, 1), 1);

inputs = [eeg_native; eeg_resting];
targets = [labels_native; labels_resting];

inputs = normalize(inputs, 'range');

[coeff, inputs_pca, ~, ~, explained] = pca(inputs);
cumulative_explained = cumsum(explained);
numComponents = find(cumulative_explained >= 95, 1); % Retain 95% variance
inputs_reduced = inputs_pca(:, 1:numComponents);

num_samples_per_class = min(sum(targets == 0), sum(targets == 1));
balanced_indices = [randsample(find(targets == 0), num_samples_per_class); ...
                    randsample(find(targets == 1), num_samples_per_class)];
inputs_balanced = inputs_reduced(balanced_indices, :);
targets_balanced = targets(balanced_indices);

cv = cvpartition(targets_balanced, 'HoldOut', 0.3);
train_inputs = inputs_balanced(training(cv), :);
train_targets = targets_balanced(training(cv));
test_inputs = inputs_balanced(test(cv), :);
test_targets = targets_balanced(test(cv));

numClasses = 2; % Two classes: native music and resting state
numPrototypes = 5; % Increase number of prototypes per class

net = lvqnet(numClasses * numPrototypes);

net.trainParam.epochs = 100; % Increase epochs for better training

% Train the LVQ Network
[net, tr] = train(net, train_inputs', train_targets');

% Test the network (evaluate the network to generate predictions)
outputs = net(test_inputs');

% Convert network outputs to class labels
[~, predictedLabels] = max(outputs, [], 1);

% Evaluate Performance
accuracy = sum(predictedLabels' == test_targets) / length(test_targets);
fprintf('Accuracy: %.2f%%\n', accuracy * 100);

% Confusion Matrix (summarize the correct and incorrect predictions in a tabular format)
confMat = confusionmat(test_targets, predictedLabels');
confusionchart(confMat);

% Calculate Precision, Recall, and F1-Score
precision = diag(confMat) ./ sum(confMat, 2);
recall = diag(confMat) ./ sum(confMat, 1)';
f1score = 2 * (precision .* recall) ./ (precision + recall);

% Display Metrics
fprintf('Precision: %.2f\n', nanmean(precision));
fprintf('Recall: %.2f\n', nanmean(recall));
fprintf('F1-Score: %.2f\n', nanmean(f1score));


